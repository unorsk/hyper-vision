# Records docs/demo.gif (run `scripts/record.sh`).
Output "docs/demo.gif"

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set Width 1028
Set Height 590
Set Padding 0
Set Framerate 24
Set Theme { "name": "CGA", "background": "#000000", "foreground": "#AAAAAA", "cursor": "#AAAAAA", "selection": "#AAAAAA", "black": "#000000", "red": "#AA0000", "green": "#00AA00", "yellow": "#AA5500", "blue": "#0000AA", "magenta": "#AA00AA", "cyan": "#00AAAA", "white": "#AAAAAA", "brightBlack": "#555555", "brightRed": "#FF5555", "brightGreen": "#55FF55", "brightYellow": "#FFFF55", "brightBlue": "#5555FF", "brightMagenta": "#FF55FF", "brightCyan": "#55FFFF", "brightWhite": "#FFFFFF" }

Hide
Type "clear && python3 scripts/drive.py --hold"
Enter
Sleep 0.5s
Show
Sleep 49s
